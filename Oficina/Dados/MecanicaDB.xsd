                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT
    V.ID_OS,
    V.Cliente,
    V.Placa,
    OS.Status_OS,
    V.Total_OS,

    ISNULL(P.Total_Pago, 0) AS Total_Pago,

    V.Total_OS - ISNULL(P.Total_Pago, 0) AS Valor_Pendente

 FROM VW_TotalOrdens V

INNER JOIN OrdensServico OS
    ON OS.ID_OS = V.ID_OS

OUTER APPLY
(
    SELECT SUM(F.Valor) AS Total_Pago

    FROM Financeiro F

    WHERE
        F.ID_OS = V.ID_OS
        AND F.Tipo = 'ENTRADA'
        AND F.Status_Pagamento = 'PAGO'

) P

 WHERE
    V.Total_OS &gt; ISNULL(P.Total_Pago, 0)

ORDER BY V.ID_OS DESC;</CommandText>
