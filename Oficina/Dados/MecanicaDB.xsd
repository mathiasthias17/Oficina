              <DbSource ConnectionRef="MecanicaDBConexao (Settings)" DbObjectType="Unknown" GenerateMethods="Get" GenerateShortCommands="true" GeneratorGetMethodName="pegar_resumo_financeiro" GetMethodModifier="Public" GetMethodName="pegar_resumo_financeiro" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="pegar_resumo_financeiro" UserSourceName="pegar_resumo_financeiro">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT
    ISNULL(SUM(
        CASE
            WHEN Tipo = 'ENTRADA'
             AND Status_Pagamento = 'PAGO'
            THEN Valor ELSE 0
        END
    ), 0) AS Total_Entradas,

    ISNULL(SUM(
        CASE
            WHEN Tipo = 'SAIDA'
             AND Status_Pagamento = 'PAGO'
            THEN Valor ELSE 0
        END
    ), 0) AS Total_Saidas,

    ISNULL(SUM(
        CASE
            WHEN Status_Pagamento = 'PAGO' AND Tipo = 'ENTRADA'
            THEN Valor
            WHEN Status_Pagamento = 'PAGO' AND Tipo = 'SAIDA'
            THEN -Valor
            ELSE 0
        END
    ), 0) AS Saldo,

    ISNULL(SUM(
        CASE
            WHEN Tipo = 'ENTRADA'
             AND Status_Pagamento = 'PENDENTE'
            THEN Valor ELSE 0
        END
    ), 0) AS Entradas_Pendentes,

    ISNULL(SUM(
        CASE
            WHEN Tipo = 'SAIDA'
             AND Status_Pagamento = 'PENDENTE'
            THEN Valor ELSE 0
        END
    ), 0) AS Saidas_Pendentes

FROM Financeiro

WHERE
    (@DataInicio IS NULL OR Data_Movimentacao &gt;= @DataInicio)
    AND
    (@DataFim IS NULL OR Data_Movimentacao &lt; DATEADD(DAY, 1, @DataFim));</CommandText>
